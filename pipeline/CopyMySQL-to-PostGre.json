				},
				"inputs": [
					{
						"referenceName": "AzureMySqlTable1_bugs_source",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "AzurePostgreSqlTable1_bugs_target",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": [],
		"lastPublishTime": "2025-07-15T07:56:13Z"
	},
